<!-- File: Android/app/src/main/res/layout/activity_main.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- GLSurfaceView for rendering -->
    <android.opengl.GLSurfaceView
        android:id="@+id/surface_gl"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Load ROM button (initially visible, disappears once menu/game starts) -->
    <Button
        android:id="@+id/button_load_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Load Game"
        android:layout_gravity="center" />

    <!-- Progress overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="#88000000">

        <ProgressBar
            android:id="@+id/otr_progress_bar"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/otr_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#FFFFFF"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- Menu overlay (hidden by default) -->
    <include
        android:id="@+id/menu_overlay"
        layout="@layout/menu_overlay"
        android:visibility="gone" />

</FrameLayout>